{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["docs/**/*.ts", "docs/**/*.vue"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["vitepress/client"]
  }
}
